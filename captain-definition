{
  "schemaVersion": 2,
  "dockerfilePath": "./Dockerfile",
  "buildArguments": {
    "CACHE_BUST": "latest",
    "NODE_ENV": "production",
    "PORT": "5000",
    "LOG_LEVEL": "info",
    "RATE_LIMIT_WINDOW_MS": "900000",
    "RATE_LIMIT_MAX_REQUESTS": "100",
    "CORS_ORIGIN": "https://extrahand.in,https://www.extrahand.in,http://localhost:3000,http://localhost:4000,http://localhost:5000",
    "USER_SERVICE_URL": "http://srv-captain--extrahand-user-service:4001",
    "TASK_SERVICE_URL": "http://srv-captain--extrahand-task-service:4002",
    "VERIFICATION_SERVICE_URL": "http://srv-captain--extrahand-user-verification:4004",
    "OLD_BACKEND_URL": "http://srv-captain--task-connect-relay:4000",
    "SERVICE_AUTH_TOKEN": "YOUR_SERVICE_AUTH_TOKEN_HERE",
    "FIREBASE_PROJECT_ID": "extrahand-app",
    "FIREBASE_PRIVATE_KEY": "YOUR_FIREBASE_PRIVATE_KEY",
    "FIREBASE_CLIENT_EMAIL": "YOUR_FIREBASE_CLIENT_EMAIL"
  },
  "expose": {
    "api": {
      "containerPort": 5000,
      "httpPort": 80,
      "httpsPort": 443
    }
  },
  "healthcheck": {
    "path": "/api/v1/health",
    "port": 5000,
    "interval": 30,
    "timeout": 10,
    "retries": 3,
    "startPeriod": 30
  },
  "notify": {
    "webhook": "",
    "slack": "",
    "discord": ""
  },
  "customDomain": "",
  "forceSsl": true,
  "appName": "extrahand-api-gateway",
  "hasPersistentData": false,
  "description": "ExtraHand API Gateway - Routes requests to microservices and handles authentication",
  "instanceCount": 1,
  "tags": ["nodejs", "typescript", "express", "firebase", "api-gateway", "extrahand", "microservices"],
  "envVars": {
    "NODE_ENV": "production"
  },
  "volumes": [
    {
      "name": "app-logs",
      "path": "/app/logs"
    }
  ],
  "restart": {
    "policy": "unless-stopped",
    "maximumRetryCount": 10
  },
  "resources": {
    "memory": "512Mi",
    "cpu": "0.5"
  },
  "networking": {
    "publishAllPorts": false,
    "enableTcpProxy": false
  }
}

