{
   "name": "extrahand-api-gateway",
   "version": "1.0.0",
   "description": "API Gateway for ExtraHand microservices",
   "private": true,
   "main": "dist/server.js",
   "type": "module",
   "scripts": {
      "start": "node dist/server.js",
      "dev": "tsx watch src/server.ts",
      "build": "tsc",
      "type-check": "tsc --noEmit",
      "prod": "npm run build && NODE_ENV=production node dist/server.js",
      "clean": "rm -rf dist"
   },
   "engines": {
      "node": ">=18"
   },
   "dependencies": {
      "axios": "^1.6.0",
      "compression": "^1.7.4",
      "cors": "^2.8.5",
      "dotenv": "^16.4.5",
      "express": "^4.19.2",
      "express-mongo-sanitize": "^2.2.0",
      "express-rate-limit": "^7.1.5",
      "form-data": "^4.0.0",
      "helmet": "^7.1.0",
      "morgan": "^1.10.0",
      "multer": "^1.4.5-lts.1",
      "winston": "^3.11.0",
      "zod": "^3.23.8",
      "uuid": "^9.0.0",
      "jsonwebtoken": "^9.0.2"
   },
   "devDependencies": {
      "@types/express": "^4.17.21",
      "@types/multer": "^1.4.11",
      "@types/node": "^20.10.0",
      "@types/cors": "^2.8.17",
      "@types/compression": "^1.7.5",
      "@types/morgan": "^1.9.9",
      "@types/uuid": "^9.0.7",
      "@types/jsonwebtoken": "^9.0.7",
      "tsx": "^4.7.0",
      "typescript": "^5.3.3"
   }
}
