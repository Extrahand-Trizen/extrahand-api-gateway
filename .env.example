# Server Configuration
NODE_ENV=development
PORT=4000

# Service URLs (for local development)
USER_SERVICE_URL=http://localhost:4001
TASK_SERVICE_URL=http://localhost:4002
QCOMMERCE_SERVICE_URL=http://localhost:4010
CHAT_SERVICE_URL=http://localhost:4006
VERIFICATION_SERVICE_URL=http://localhost:4004

# Service Authentication
SERVICE_AUTH_TOKEN=your-shared-secret-token-here

# Access Token Verification (MUST match extrahand-user-service .env exactly)
# User-service signs JWTs; api-gateway verifies them. "Invalid signature" = mismatch.
ACCESS_TOKEN_SECRET=change-me-access-secret
TOKEN_ISSUER=extrahand-user-service
TOKEN_AUDIENCE=extrahand-clients

# Firebase Configuration (primary — web app)
# FIREBASE_PROJECT_ID=extrahand-app
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@extrahand-app.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Mobile Firebase Configuration (extrahand-ca02c — required for React Native app tokens)
# Mobile apps (extrahand-helper-mobile-app / extrahand-mobile-app) use project extrahand-ca02c.
# Download a service account key from Firebase Console → extrahand-ca02c → Project settings → Service accounts.
# Or place serviceAccountKey-mobile.json in the gateway root directory.
# FIREBASE_MOBILE_PROJECT_ID=extrahand-ca02c
# FIREBASE_MOBILE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@extrahand-ca02c.iam.gserviceaccount.com
# FIREBASE_MOBILE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_MOBILE_SERVICE_ACCOUNT_PATH=./serviceAccountKey-mobile.json

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,http://localhost:4000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
